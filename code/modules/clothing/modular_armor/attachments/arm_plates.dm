/**
 *  Arms pieces
*/

/obj/item/armor_module/armor/arms
	icon_state = "arm"
	slot = ATTACHMENT_SLOT_SHOULDER
	greyscale_config = /datum/greyscale_config/armor_mk1/infantry
	colorable_colors = ARMOR_PALETTES_LIST

/obj/item/armor_module/armor/arms/marine
	name = "\improper Jaeger型步兵臂甲"
	desc = "专为搭配Jaeger战斗外骨骼使用而设计. 安装后可提供防护并增加负重, 且相当容易从装甲上安装和拆卸. 点击装甲框架即可安装. 所有臂甲都具有相同的防护和减速效果, 这意味着只有更换胸甲才会带来显著的防护差异. 该装甲似乎被标记为步兵装甲部件."

